const BLBL={easy:'Facile',quality:'Qualità',medium:'Medio',rest:'Riposo',tennis:'Tennis',gym:'Palestra',race:'GARA'};
const BPILL={10:'bp-10k','10K':'bp-10k',Mezza:'bp-mezza',Maratona:'bp-mar',OUT:'bp-10k'};
const BICON={'10K':'⚡',Mezza:'🏃',Maratona:'💪',OUT:'⛔'};

function pad(n){return String(n).padStart(2,'0');}
function toDate(s){const[y,m,d]=s.split('-').map(Number);const dt=new Date(y,m-1,d);dt.setHours(0,0,0,0);return dt;}

// Header date
document.getElementById('hdr-date').textContent=new Date().toLocaleDateString('it-IT',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).toUpperCase();

// Countdown
function updateCountdown(){
  const now=new Date();
  const next=RACES.find(r=>toDate(r.date)>=now)||RACES[RACES.length-1];
  const rd=new Date(next.date+'T06:00:00');
  const diff=rd-now;
  document.getElementById('nr-name').textContent=next.name;
  document.getElementById('nr-date').textContent=toDate(next.date).toLocaleDateString('it-IT',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  document.getElementById('nr-target').textContent=next.badge;
  if(diff>0){
    document.getElementById('cd-d').textContent=pad(Math.floor(diff/86400000));
    document.getElementById('cd-h').textContent=pad(Math.floor(diff%86400000/3600000));
    document.getElementById('cd-m').textContent=pad(Math.floor(diff%3600000/60000));
    document.getElementById('cd-s').textContent=pad(Math.floor(diff%60000/1000));
  }
}
setInterval(updateCountdown,1000);
updateCountdown();

// Rules accordion
function renderRules(){
  const body=document.getElementById('rules-body');
  RULES.forEach((r,i)=>{
    const cat=document.createElement('div');
    cat.className='rule-cat '+r.cls+(i===0?' open':'');
    const head=document.createElement('div');
    head.className='rule-cat-head';
    head.innerHTML=`<span class="rule-cat-icon">${r.icon}</span><span class="rule-cat-title">${r.title}</span><span class="rule-cat-arr">›</span>`;
    head.addEventListener('click',()=>cat.classList.toggle('open'));
    const bdy=document.createElement('div');
    bdy.className='rule-cat-body';
    r.items.forEach(it=>{
      const d=document.createElement('div');
      d.className='rule-item';
      d.textContent=it;
      bdy.appendChild(d);
    });
    cat.appendChild(head);cat.appendChild(bdy);
    body.appendChild(cat);
  });
}
renderRules();

// Week plan
let weekIdx=0;
function getAutoWeek(){
  const today=new Date();today.setHours(0,0,0,0);
  let best=-1;
  for(let i=0;i<W.length;i++){
    const s=toDate(W[i].start),e=toDate(W[i].end);
    if(today>=s&&today<=e) return i;
    if(today<s&&best===-1) best=i;
  }
  return best===-1?W.length-1:best;
}

const MONTHS=['Gen','Feb','Mar','Apr','Mag','Giu','Lug','Ago','Set','Ott','Nov','Dic'];
function fmtShort(s){const d=toDate(s);return d.getDate()+' '+MONTHS[d.getMonth()];}

function renderWeek(){
  const today=new Date();today.setHours(0,0,0,0);
  const week=W[weekIdx];
  const range=fmtShort(week.start)+' – '+fmtShort(week.end);
  document.getElementById('week-lbl').textContent='📅 '+week.label;
  document.getElementById('week-dates').textContent='📆 '+range;
  const pw=document.getElementById('block-pill-wrap');
  pw.innerHTML='';
  if(week.block!=='OUT'){
    const p=document.createElement('div');
    p.className='block-pill '+(BPILL[week.block]||'bp-10k');
    p.textContent=(BICON[week.block]||'')+' Blocco '+week.block;
    pw.appendChild(p);
  }
  const body=document.getElementById('week-body');
  body.innerHTML='';
  week.s.forEach(s=>{
    const sd=toDate(s.date);
    const isToday=sd.getTime()===today.getTime();
    const isPast=sd<today&&!isToday;
    const dayNum=s.date.split('-')[2];

    const row=document.createElement('div');row.className='s-row';

    const dcol=document.createElement('div');
    dcol.className='s-day-col'+(isToday?' today':'');
    dcol.innerHTML=`<div class="s-day">${s.day}</div><div class="s-daynum">${dayNum}</div>`;

    const dot=document.createElement('div');dot.className='s-dot dot-'+s.type;
    const txt=document.createElement('div');txt.className='s-text'+(isPast?' past':'');txt.textContent=s.text;
    const badge=document.createElement('div');badge.className='s-badge b-'+s.type;badge.textContent=BLBL[s.type]||s.type;

    row.appendChild(dcol);row.appendChild(dot);row.appendChild(txt);row.appendChild(badge);
    body.appendChild(row);
  });
}

weekIdx=getAutoWeek();
renderWeek();
document.getElementById('btn-prev').addEventListener('click',()=>{if(weekIdx>0){weekIdx--;renderWeek();}});
document.getElementById('btn-next').addEventListener('click',()=>{if(weekIdx<W.length-1){weekIdx++;renderWeek();}});

// Race calendar
function renderRaces(){
  const today=new Date();today.setHours(0,0,0,0);
  const c=document.getElementById('race-list');
  const nextR=RACES.find(r=>toDate(r.date)>=today);
  RACES.forEach(r=>{
    const rd=toDate(r.date);
    const isDone=rd<today,isNext=r===nextR;
    const row=document.createElement('div');
    row.className='race-row'+(isNext?' next':'')+(isDone?' done':'');
    const em=document.createElement('div');em.className='r-emoji';em.textContent=isDone?'✅':r.emoji;
    const meta=document.createElement('div');meta.className='r-meta';
    meta.innerHTML=`<div class="r-name">${r.name}</div><div class="r-date">${rd.toLocaleDateString('it-IT',{day:'numeric',month:'long',year:'numeric'})}</div>`;
    const badge=document.createElement('div');
    badge.className='r-badge '+(isNext?'r-next':isDone?'r-done':'r-fut');
    badge.textContent=r.badge;
    row.appendChild(em);row.appendChild(meta);row.appendChild(badge);
    c.appendChild(row);
  });
}
renderRaces();
