<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Velocci">
  <meta name="theme-color" content="#FFFFFF">
  <title>Velocci Running Program</title>
  <link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Bebas+Neue&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:      #FFFFFF;
      --cream:   #EEF3FA;
      --ink:     #1A3A6A;
      --celeste: #2B7BBF;
      --gold:    #C07818;
      --green:   #1A6842;
      --purple:  #5C3A8A;
      --rose:    #A02860;
      --muted:   #6080A8;
      --white:   #FFFFFF;
      --border:  rgba(43,123,191,0.15);
      --red:     #A02828;
    }
    html,body { background:var(--bg); color:var(--ink); font-family:'Inter',system-ui,sans-serif; min-height:100vh; -webkit-font-smoothing:antialiased; }
    .app { max-width:430px; margin:0 auto; padding:max(env(safe-area-inset-top),16px) 16px max(env(safe-area-inset-bottom),28px); }

    /* ── HEADER ── */
    .header { text-align:center; padding:24px 0 28px; }
    .logo {
      font-family:'Pacifico', cursive;
      font-size:3.8rem;
      letter-spacing:0.02em;
      line-height:1;
      color:var(--celeste);
    }
    .deco-line {
      display:flex; align-items:center; gap:10px;
      margin:10px auto 6px;
      max-width:260px;
    }
    .deco-line::before, .deco-line::after {
      content:''; flex:1; height:1.5px; background:var(--ink); opacity:0.25;
    }
    .deco-text {
      font-family:'Bebas Neue',sans-serif;
      font-size:0.65rem;
      letter-spacing:0.35em;
      color:var(--muted);
      white-space:nowrap;
    }
    .tagline { font-family:'Pacifico',cursive; font-size:0.95rem; color:var(--muted); margin-top:4px; }
    .hdr-date { font-family:'Space Mono',monospace; font-size:0.6rem; color:var(--muted); margin-top:10px; opacity:0.6; }

    /* ── CARDS ── */
    .card { background:var(--white); border:2px solid var(--ink); border-radius:12px; padding:18px; margin-bottom:12px; }
    .card-label {
      font-family:'Bebas Neue',sans-serif; font-size:1rem; letter-spacing:0.18em;
      color:var(--ink); margin-bottom:14px; display:flex; align-items:center; gap:8px;
    }
    .card-label::after { content:''; flex:1; height:1.5px; background:var(--ink); opacity:0.12; }

    /* ── COUNTDOWN ── */
    .next-card { background:var(--celeste); border-color:var(--ink); }
    .next-card .card-label { color:var(--white); }
    .next-card .card-label::after { background:var(--white); opacity:0.25; }
    .next-name { font-family:'Bebas Neue',sans-serif; font-size:2.1rem; letter-spacing:0.08em; color:var(--white); line-height:1; }
    .next-date { font-size:0.72rem; color:rgba(255,255,255,0.72); margin:4px 0 14px; }
    .countdown { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:14px; }
    .cd-box { background:rgba(0,0,0,0.18); border-radius:8px; padding:11px 4px 9px; text-align:center; border:1px solid rgba(255,255,255,0.2); }
    .cd-num { font-family:'Space Mono',monospace; font-weight:700; font-size:1.5rem; color:var(--white); display:block; line-height:1; }
    .cd-lbl { font-size:0.5rem; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.6); display:block; margin-top:4px; }
    .target-pill { display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:rgba(0,0,0,0.2); border-radius:8px; }
    .target-lbl { font-size:0.68rem; color:rgba(255,255,255,0.7); text-transform:uppercase; letter-spacing:0.1em; }
    .target-val { font-family:'Bebas Neue',sans-serif; font-size:1.4rem; letter-spacing:0.1em; color:var(--white); }

    /* ── WEEK ── */
    .week-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
    .week-header .card-label { margin-bottom:0; }
    .week-nav { display:flex; gap:6px; }
    .week-btn {
      width:28px; height:28px; border-radius:6px; border:2px solid var(--ink);
      background:transparent; color:var(--ink); font-size:0.9rem; font-weight:700;
      cursor:pointer; display:flex; align-items:center; justify-content:center;
      -webkit-tap-highlight-color:transparent; user-select:none;
    }
    .week-btn:active { background:var(--ink); color:var(--white); }
    .block-pill {
      display:inline-flex; align-items:center; gap:5px;
      font-family:'Bebas Neue',sans-serif; font-size:0.75rem; letter-spacing:0.15em;
      padding:3px 10px; border-radius:20px; margin-bottom:12px;
    }
    .bp-10k   { background:rgba(43,123,191,0.1); color:var(--celeste); border:1.5px solid var(--celeste); }
    .bp-mezza { background:rgba(160,40,96,0.1);  color:var(--rose);    border:1.5px solid var(--rose); }
    .bp-mar   { background:rgba(192,120,24,0.1); color:var(--gold);    border:1.5px solid var(--gold); }

    /* Session row */
    .s-row { display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--border); }
    .s-row:last-child { border-bottom:none; }
    .s-day-col { display:flex; flex-direction:column; align-items:center; width:34px; flex-shrink:0; }
    .s-day { font-family:'Bebas Neue',sans-serif; font-size:0.85rem; letter-spacing:0.06em; color:var(--muted); line-height:1; }
    .s-daynum { font-family:'Space Mono',monospace; font-size:0.65rem; color:var(--muted); margin-top:2px; }
    .s-day-col.today .s-day, .s-day-col.today .s-daynum { color:var(--celeste); }
    .s-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .dot-easy    { background:var(--celeste); }
    .dot-quality { background:var(--rose); }
    .dot-medium  { background:var(--gold); }
    .dot-rest    { background:transparent; border:1.5px solid var(--muted); }
    .dot-tennis  { background:var(--green); }
    .dot-gym     { background:var(--purple); }
    .dot-race    { background:var(--ink); }
    .s-text { font-size:0.82rem; color:var(--ink); flex:1; line-height:1.35; }
    .s-text.past { opacity:0.3; text-decoration:line-through; }
    .s-badge { font-family:'Bebas Neue',sans-serif; font-size:0.68rem; letter-spacing:0.08em; padding:2px 8px; border-radius:4px; white-space:nowrap; flex-shrink:0; }
    .b-easy    { background:rgba(43,123,191,0.1);  color:var(--celeste); }
    .b-quality { background:rgba(160,40,96,0.1);   color:var(--rose); }
    .b-medium  { background:rgba(192,120,24,0.1);  color:var(--gold); }
    .b-rest    { background:var(--cream); color:var(--muted); }
    .b-tennis  { background:rgba(26,104,66,0.1);   color:var(--green); }
    .b-gym     { background:rgba(92,58,138,0.1);   color:var(--purple); }
    .b-race    { background:var(--ink); color:var(--white); }

    /* ── RULES (accordion) ── */
    .rule-cat {
      border:1.5px solid var(--border);
      border-radius:8px;
      margin-bottom:8px;
      overflow:hidden;
    }
    .rule-cat-head {
      display:flex; align-items:center; gap:10px;
      padding:11px 14px;
      cursor:pointer;
      background:var(--cream);
      user-select:none;
      -webkit-tap-highlight-color:transparent;
    }
    .rule-cat-head:active { opacity:0.8; }
    .rule-cat-icon { font-size:1rem; flex-shrink:0; }
    .rule-cat-title { font-family:'Bebas Neue',sans-serif; font-size:0.95rem; letter-spacing:0.12em; flex:1; }
    .rule-cat-arr { font-size:0.75rem; color:var(--muted); transition:transform 0.2s; }
    .rule-cat.open .rule-cat-arr { transform:rotate(90deg); }
    .rule-cat-body { display:none; padding:10px 14px 12px; background:var(--white); }
    .rule-cat.open .rule-cat-body { display:block; }
    .rule-item {
      display:flex; align-items:baseline; gap:8px;
      font-size:0.78rem; color:var(--ink); padding:5px 0;
      border-bottom:1px solid var(--border);
      line-height:1.4;
    }
    .rule-item:last-child { border-bottom:none; padding-bottom:0; }
    .rule-item::before { content:'—'; color:var(--muted); flex-shrink:0; font-size:0.7rem; }

    /* color accents per category */
    .rc-celeste .rule-cat-title { color:var(--celeste); }
    .rc-green   .rule-cat-title { color:var(--green); }
    .rc-gold    .rule-cat-title { color:var(--gold); }
    .rc-rose    .rule-cat-title { color:var(--rose); }
    .rc-purple  .rule-cat-title { color:var(--purple); }

    /* ── RACE CALENDAR ── */
    .race-list { display:flex; flex-direction:column; gap:8px; }
    .race-row { display:flex; align-items:center; gap:12px; padding:12px 14px; background:var(--cream); border-radius:8px; border:1.5px solid var(--border); }
    .race-row.next { background:var(--ink); border-color:var(--ink); }
    .race-row.done { opacity:0.38; }
    .r-emoji { font-size:1.1rem; width:26px; text-align:center; }
    .r-meta { flex:1; }
    .r-name { font-family:'Bebas Neue',sans-serif; font-size:1.05rem; letter-spacing:0.04em; color:var(--ink); }
    .race-row.next .r-name { color:var(--white); }
    .r-date { font-size:0.67rem; color:var(--muted); margin-top:2px; }
    .race-row.next .r-date { color:rgba(255,255,255,0.55); }
    .r-badge { font-family:'Space Mono',monospace; font-size:0.78rem; font-weight:700; }
    .r-next { color:var(--white); } .r-fut { color:var(--muted); } .r-done { color:var(--green); }

    /* ── PACE ── */
    .pace-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .pace-box { background:var(--cream); border:1.5px solid var(--border); border-radius:8px; padding:14px 8px; text-align:center; }
    .p-dist { font-family:'Bebas Neue',sans-serif; font-size:0.85rem; letter-spacing:0.12em; color:var(--muted); margin-bottom:6px; }
    .p-val  { font-family:'Space Mono',monospace; font-weight:700; font-size:1.05rem; color:var(--ink); margin-bottom:2px; }
    .p-unit { font-size:0.5rem; color:var(--muted); margin-bottom:6px; }
    .p-fin  { font-family:'Bebas Neue',sans-serif; font-size:0.8rem; letter-spacing:0.06em; color:var(--green); background:rgba(26,104,66,0.1); border-radius:6px; padding:2px 6px; }

    .footer { text-align:center; padding:18px 0 4px; font-family:'Bebas Neue',sans-serif; font-size:0.7rem; letter-spacing:0.25em; color:var(--muted); }
  </style>
</head>
